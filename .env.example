# Google Apps Script Webhook URL (for 1-click upload to Google Sheets)
GOOGLE_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Apollo.io API Key (for 100% verified direct emails)
APOLLO_API_KEY=

# Optional: Hunter.io API Key for deep SMTP deliverability verification
HUNTER_API_KEY=

# Default email permutation pattern
DEFAULT_PATTERN=first.last

PORT=8000
