# ========================================================
# Environment Variables Example for Web Deployment
# Copy this to .env locally or set these in your hosting dashboard
# (Render / Railway / Vercel / Hugging Face Spaces)
# ========================================================

# Google Apps Script Webhook URL (from Google Sheets > Extensions > Apps Script)
GOOGLE_WEBHOOK_URL=your_google_apps_script_url_here

# Apollo.io API Key (from Apollo.io > Settings > Integrations > API Keys)
APOLLO_API_KEY=your_apollo_api_key_here

# Hunter.io API Key (Optional)
HUNTER_API_KEY=

# Default Corporate Email Pattern (first.last, flast, etc.)
DEFAULT_PATTERN=first.last

# Server Port (Default 8000; cloud hosts set this automatically)
PORT=8000
